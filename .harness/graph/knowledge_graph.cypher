MERGE (c:IsnadClaim {id: "ki_oliinyk_geospatial_disaster_simulation-c1"}) ON CREATE SET c.assertion = "Ground simulations must be computed in map coordinates rather than screen coordinates; drawing on an overlay screen-space canvas produces visible edges, artificial clipping, and perspective desynchronization when the map tilts or rotates (the 'Sticker Problem').", c.status = "VERIFIED", c.confidence = 1.00, c.evidence_type = "architectural_axiom", c.source = "Alex Oliinyk: 'The Core Idea: Map Space, Not Screen Space' (2026)", c.verified = true, c.verified_by = "";
MERGE (c:IsnadClaim {id: "ki_oliinyk_geospatial_disaster_simulation-c2"}) ON CREATE SET c.assertion = "Aligning simulation grids to Web Mercator tile pyramids allows direct ingestion and decoding of elevation tiles (AWS Open Data Terrarium or Mapbox Terrain-RGB) into contiguous 1D Float32Array grids without data resampling.", c.status = "VERIFIED", c.confidence = 1.00, c.evidence_type = "procedural_standard", c.source = "Alex Oliinyk: 'Step 1: Choose a Grid Aligned to Map Tiles' & 'Step 2: Load Real Elevation Into the Grid' (2026)", c.verified = true, c.verified_by = "";
MERGE (c:IsnadClaim {id: "ki_oliinyk_geospatial_disaster_simulation-c3"}) ON CREATE SET c.assertion = "Ground fluid textures composite seamlessly over terrain when an offscreen canvas is registered as a map canvas raster source with animate: true, raster-resampling: linear, and raster-fade-duration: 0.", c.status = "VERIFIED", c.confidence = 1.00, c.evidence_type = "rendering_protocol", c.source = "Alex Oliinyk: 'Step 3: Attach a Canvas as a Map Source' & 'Step 6: Layer Video Textures' (2026)", c.verified = true, c.verified_by = "";
MERGE (c:IsnadClaim {id: "ki_oliinyk_geospatial_disaster_simulation-c4"}) ON CREATE SET c.assertion = "Mapbox Streets vector tile buildings lack native feature IDs; calling setFeatureState() on vector tiles silently fails. Buildings must be copied into a GeoJSON source with promoteId: 'i' to animate extrusion collapse via feature-state height multipliers without layer rebuilding.", c.status = "VERIFIED", c.confidence = 1.00, c.evidence_type = "field_tested_gotcha", c.source = "Alex Oliinyk: 'Step 11: Animate Collapse Without Rebuilding Layers' & 'Gotchas: Nothing Happened When I Set Feature State' (2026)", c.verified = true, c.verified_by = "";
MERGE (c:IsnadClaim {id: "ki_oliinyk_geospatial_disaster_simulation-c5"}) ON CREATE SET c.assertion = "Foreground 3D structural objects and debris must be rendered via a Three.js custom layer configured with renderingMode: '3d' in Mapbox's WebGL context to share the depth buffer with extruded buildings.", c.status = "VERIFIED", c.confidence = 1.00, c.evidence_type = "architectural_pattern", c.source = "Alex Oliinyk: 'Step 12: A Three.js Scene Inside the Map' (2026)", c.verified = true, c.verified_by = "";
MERGE (c:IsnadClaim {id: "ki_oliinyk_geospatial_disaster_simulation-c6"}) ON CREATE SET c.assertion = "Three.js InstancedMesh instanceColor must be pre-allocated for full capacity at initialization; instancing starting at count=0 lazily allocates zero entries, causing all debris instances to render completely black.", c.status = "VERIFIED", c.confidence = 1.00, c.evidence_type = "field_tested_gotcha", c.source = "Alex Oliinyk: 'Gotchas: Every Instance Was Black' (2026)", c.verified = true, c.verified_by = "";
MERGE (c:IsnadClaim {id: "ki_oliinyk_geospatial_disaster_simulation-c7"}) ON CREATE SET c.assertion = "Earthquake camera shaking must be applied via CSS transform to the map DOM container rather than the map camera matrix; camera jitter triggers continuous vector and raster tile re-fetching.", c.status = "VERIFIED", c.confidence = 1.00, c.evidence_type = "optimization_heuristic", c.source = "Alex Oliinyk: 'Step 15: The Camera Has to Shake' (2026)", c.verified = true, c.verified_by = "";
