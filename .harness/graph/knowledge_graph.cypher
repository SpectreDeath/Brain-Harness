MERGE (c:IsnadClaim {id: "ki_umairmirza_precommit_security-c4"}) ON CREATE SET c.assertion = "Developer workstations cannot provide authoritative security guarantees because pre-commit hooks can be bypassed using git commit --no-verify; remote CI must enforce identical checks with full git history depth (fetch-depth: 0) and upload SARIF reports to the repository security tab.", c.status = "VERIFIED", c.confidence = 1.00, c.evidence_type = "security_standard", c.source = "Umair Mirza: 'Add Security Checks to CI Too' (2026) + GitHub SARIF Security Governance", c.verified = true, c.verified_by = "";
MERGE (c:IsnadClaim {id: "ki_vudathala_agentic_reliability_harness-c1"}) ON CREATE SET c.assertion = "A polite, fluent conversational response is not evidence that an agentic workflow succeeded; outcome correctness must be verified directly from authoritative world state, completely independent of the agent's narration.", c.status = "VERIFIED", c.confidence = 1.00, c.evidence_type = "architectural_axiom", c.source = "Vasuki Uday Kiran Vudathala: 'The Demo That Lied' & Chapter 1 (2026)", c.verified = true, c.verified_by = "";
MERGE (c:IsnadClaim {id: "ki_vudathala_agentic_reliability_harness-c2"}) ON CREATE SET c.assertion = "Evaluation requires two distinct orthogonal taxonomies: Six Evaluation Activities (when and why evidence is gathered) and Five Evaluation Levels (what structural component of an execution is judged: Response, Step, Action, Workflow, System).", c.status = "VERIFIED", c.confidence = 1.00, c.evidence_type = "conceptual_taxonomy", c.source = "Vasuki Uday Kiran Vudathala: Chapters 2 & 3 (2026)", c.verified = true, c.verified_by = "";
MERGE (c:IsnadClaim {id: "ki_vudathala_agentic_reliability_harness-c3"}) ON CREATE SET c.assertion = "The agent must never supply its own identity, tenant, or scopes; SecurityContext must be bound to the Policy Enforcement Point (PEP) Gateway at request initialization, and the gateway must fail closed.", c.status = "VERIFIED", c.confidence = 1.00, c.evidence_type = "security_standard", c.source = "Vasuki Uday Kiran Vudathala: Chapter 14 (2026)", c.verified = true, c.verified_by = "";
MERGE (c:IsnadClaim {id: "ki_vudathala_agentic_reliability_harness-c4"}) ON CREATE SET c.assertion = "Safety guardrail evaluation must distinguish four discrete outcomes: pass (control blocked forbidden action), fail/bypass (control breached), not_exercised (action never attempted), and indeterminate.", c.status = "VERIFIED", c.confidence = 1.00, c.evidence_type = "verification_rule", c.source = "Vasuki Uday Kiran Vudathala: Chapter 11 (2026)", c.verified = true, c.verified_by = "";
MERGE (c:IsnadClaim {id: "ki_vudathala_agentic_reliability_harness-c5"}) ON CREATE SET c.assertion = "Release gates must be three-state (pass, fail, inconclusive); missing or ambiguous telemetry must block releases without dishonesty, and critical safety metrics must enforce the Rule of Three upper bound with zero observed false successes under fault.", c.status = "VERIFIED", c.confidence = 1.00, c.evidence_type = "release_governance", c.source = "Vasuki Uday Kiran Vudathala: Chapters 17 & 18 (2026)", c.verified = true, c.verified_by = "";

