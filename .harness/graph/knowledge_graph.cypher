MERGE (c:IsnadClaim {id: "ki-empirical-harness-calibration-c1"}) ON CREATE SET c.assertion = "Context management value scales inversely with window budget: at 32k budget without management (T0), agents catastrophically collapse (6.4%–12.6% SR, median 20–30 turns, dying at localization); rule-based elision (T1) rescues success to 20.6%–64.4% by sustaining 50–180 turns into verification.", c.status = "VERIFIED", c.confidence = 1.00, c.evidence_type = "empirical_benchmark", c.source = "Fan et al. (arXiv:2609.20804v1, 2026), Section 3.2, Table 3 & Figure 32", c.verified = true, c.verified_by = "";
MERGE (c:IsnadClaim {id: "ki-empirical-harness-calibration-c2"}) ON CREATE SET c.assertion = "Staging rule-based elision (M1) at soft threshold B1 (0.60 usable window) before LLM summarization (M3) at hard threshold B2 (0.85 usable window) provides optimal token efficiency, minimizing expensive summarization calls while strictly bounding peak context.", c.status = "VERIFIED", c.confidence = 1.00, c.evidence_type = "architectural_seam", c.source = "Fan et al. (arXiv:2609.20804v1, 2026), Section 2.3 (Algorithm 1), Section 3.2 & Figure 5", c.verified = true, c.verified_by = "";
MERGE (c:IsnadClaim {id: "ki-empirical-harness-calibration-c3"}) ON CREATE SET c.assertion = "Recoverable elision (M2 recall_event) adds complex external storage machinery that agents rarely invoke (<0.1% of turns) and yields zero statistically significant accuracy gain over irreversible elision (p > 0.05 across all models on SWE-Bench and Terminal-Bench).", c.status = "VERIFIED", c.confidence = 1.00, c.evidence_type = "ablation_study", c.source = "Fan et al. (arXiv:2609.20804v1, 2026), Section 3.2, Table 3, Table 4 & Appendix C.6", c.verified = true, c.verified_by = "";
MERGE (c:IsnadClaim {id: "ki-empirical-harness-calibration-c4"}) ON CREATE SET c.assertion = "Planning exhibits a capability duality: for weaker models (Nemotron-3 30B), it acts as an accuracy scaffold (raising SWE-Bench SR from 14% to 25% by preventing premature termination, dropping unedited runs from 68.6% to 27.8%); for stronger models (Nemotron-3 550B, Mistral-Medium-3.5), it acts as a cost saver (cutting trajectory length by 23%–31% and cost by 25%–48% by truncating redundant post-edit verification loops).", c.status = "VERIFIED", c.confidence = 1.00, c.evidence_type = "trajectory_analysis", c.source = "Fan et al. (arXiv:2609.20804v1, 2026), Section 3.2, Table 5, Table 6, Figure 8 & Figure 9", c.verified = true, c.verified_by = "";
MERGE (c:IsnadClaim {id: "ki-empirical-harness-calibration-c5"}) ON CREATE SET c.assertion = "Action space optimal boundary depends on model capability and workload shell-centricity: predefined tools prevent syntax/interface hallucinations for weaker models; bash-only enables capable models on terminal-centric tasks to compose dense scripts, cutting re-patches from 4.6 to 1.5 and costs by 30%–53%.", c.status = "VERIFIED", c.confidence = 1.00, c.evidence_type = "empirical_benchmark", c.source = "Fan et al. (arXiv:2609.20804v1, 2026), Section 3.2, Table 4, Table 7 & Figure 7", c.verified = true, c.verified_by = "";
MERGE (c:IsnadClaim {id: "ki-harnesscompass-evolution-c1"}) ON CREATE SET c.assertion = "Conventional Automatic Harness Evolution (AHE) overfits to search tasks, accumulating task-specific branches and memorized symbols that degrade held-out generalization.", c.status = "VERIFIED", c.confidence = 1.00, c.evidence_type = "empirical_benchmark", c.source = "Zhang et al. (arXiv:2608.01918v1, 2026), Section 1 & Section 4", c.verified = true, c.verified_by = "";
MERGE (c:IsnadClaim {id: "ki-harnesscompass-evolution-c2"}) ON CREATE SET c.assertion = "A Global Generalization Gate enforcing Content Invariants (zero task IDs, test names, or private symbols) and Placement Invariants (Capability in middleware/tools vs Guidance in prompt/memory) improves held-out Pass@1 from 51.6% to 58.4% in 2 iterations.", c.status = "VERIFIED", c.confidence = 1.00, c.evidence_type = "ablation_study", c.source = "Zhang et al. (arXiv:2608.01918v1, 2026), Table 2 (Ablation on HarnessCompass)", c.verified = true, c.verified_by = "";
MERGE (c:IsnadClaim {id: "ki-harnesscompass-evolution-c3"}) ON CREATE SET c.assertion = "Eliciting first-person Blind pre-verdict reflections combined with post-verdict failure attribution isolates harness friction from model reasoning and environment noise, avoiding hindsight rationalization bias.", c.status = "VERIFIED", c.confidence = 1.00, c.evidence_type = "architectural_seam", c.source = "Zhang et al. (arXiv:2608.01918v1, 2026), Section 3 (Proactive Feedback) & Appendix A", c.verified = true, c.verified_by = "";
MERGE (c:IsnadClaim {id: "ki-harnesscompass-evolution-c4"}) ON CREATE SET c.assertion = "Partitioning evolution into disjoint Structural and Guidance tracks and reconciling via R3 (Revision, Recombination, Refinement) achieves 61.0% total Pass@1 in 5 iterations on SWE-Bench Verified (outperforming AHE's 55.5% in 20 iterations) while eliminating advisory prompt bloat.", c.status = "VERIFIED", c.confidence = 1.00, c.evidence_type = "empirical_benchmark", c.source = "Zhang et al. (arXiv:2608.01918v1, 2026), Table 1 & Figure 2", c.verified = true, c.verified_by = "";
MERGE (c:IsnadClaim {id: "ki-harnesscompass-evolution-c5"}) ON CREATE SET c.assertion = "Harnesses evolved with HarnessCompass transfer across foundational models (e.g. from GPT-5.4 to Claude-Sonnet-4.6) without regression, demonstrating domain-general engineering robustness.", c.status = "VERIFIED", c.confidence = 1.00, c.evidence_type = "cross_model_evaluation", c.source = "Zhang et al. (arXiv:2608.01918v1, 2026), Table 3 & Section 4", c.verified = true, c.verified_by = "";
MERGE (c:IsnadClaim {id: "ki-hf-datasets-arrow-streaming-c1"}) ON CREATE SET c.assertion = "Dataset wraps PyArrow tables with memory-mapped backing files, enabling terabyte-scale tabular indexing, zero-copy column slicing, and batch mapping without loading entire datasets into RAM.", c.status = "VERIFIED", c.confidence = 1.00, c.evidence_type = "", c.source = "src/datasets/arrow_dataset.py", c.verified = true, c.verified_by = "";
MERGE (c:IsnadClaim {id: "ki-hf-datasets-arrow-streaming-c2"}) ON CREATE SET c.assertion = "IterableDataset implements lazy generator pipelines with shard-level parallel prefetching, buffer-windowed shuffling, and dynamic interleave combinators for unbounded data streams.", c.status = "VERIFIED", c.confidence = 1.00, c.evidence_type = "", c.source = "src/datasets/iterable_dataset.py", c.verified = true, c.verified_by = "";
MERGE (c:IsnadClaim {id: "ki-hf-datasets-arrow-streaming-c3"}) ON CREATE SET c.assertion = "Deterministic transform caching hashes dataset internal state, function bytecode, and execution kwargs using Hasher (xxhash + dill), preventing redundant re-computation of dataset transforms across sessions.", c.status = "VERIFIED", c.confidence = 1.00, c.evidence_type = "", c.source = "src/datasets/fingerprint.py", c.verified = true, c.verified_by = "";
MERGE (c:IsnadClaim {id: "ki-hf-datasets-arrow-streaming-c4"}) ON CREATE SET c.assertion = "Features provides polymorphic schema validation and decoding for multimodal data (Audio, Image, Video, Mesh, PDF, NIfTI) and biological structures (BioSequence, BioStructure).", c.status = "VERIFIED", c.confidence = 1.00, c.evidence_type = "", c.source = "src/datasets/features/features.py", c.verified = true, c.verified_by = "";
MERGE (c:IsnadClaim {id: "ki-paperless-ai-rag-sqlite-vec-c1"}) ON CREATE SET c.assertion = "paperless_ai embeds documents into a dedicated SQLite database (llmindex.db) using the sqlite-vec C extension, eliminating the need for standalone vector database microservices.", c.status = "VERIFIED", c.confidence = 1.00, c.evidence_type = "", c.source = "src/paperless_ai/vector_store.py", c.verified = true, c.verified_by = "";
MERGE (c:IsnadClaim {id: "ki-paperless-ai-rag-sqlite-vec-c2"}) ON CREATE SET c.assertion = "Documents are split into overlapping chunks with RAG_NUM_OUTPUT=512 and RAG_CHUNK_OVERLAP=200, streaming through QuerySetStream with _INDEX_STREAM_CHUNK_SIZE=1000 to bound memory.", c.status = "VERIFIED", c.confidence = 1.00, c.evidence_type = "", c.source = "src/paperless_ai/indexing.py", c.verified = true, c.verified_by = "";
MERGE (c:IsnadClaim {id: "ki-paperless-ai-rag-sqlite-vec-c3"}) ON CREATE SET c.assertion = "The streaming chat endpoint (/api/documents/chat/) yields Server-Sent Events with delimited metadata (__PAPERLESS_CHAT_METADATA__) containing exact document citations and confidence bounds.", c.status = "VERIFIED", c.confidence = 1.00, c.evidence_type = "", c.source = "src/paperless_ai/chat.py", c.verified = true, c.verified_by = "";
MERGE (c:IsnadClaim {id: "ki-paperless-ngx-architecture-c1"}) ON CREATE SET c.assertion = "The consumer coordinates a 9-stage pipeline: pre-check duplicates, ASN uniqueness, pre-consume script, pluggable parser execution (OCRmyPDF/Tika), ML classification, unique filename generation, storage write, post-consume script, and workflow triggers.", c.status = "VERIFIED", c.confidence = 1.00, c.evidence_type = "", c.source = "src/documents/consumer.py", c.verified = true, c.verified_by = "";
MERGE (c:IsnadClaim {id: "ki-paperless-ngx-architecture-c2"}) ON CREATE SET c.assertion = "Concurrency safety during document ingestion and index updates is guaranteed by filelock FileLock and ReadWriteLock instances wrapping storage directories and vector indices.", c.status = "VERIFIED", c.confidence = 1.00, c.evidence_type = "", c.source = "src/documents/consumer.py", c.verified = true, c.verified_by = "";
MERGE (c:IsnadClaim {id: "ki-paperless-ngx-architecture-c3"}) ON CREATE SET c.assertion = "Client communication and UI telemetry is decoupled into 25+ DRF ViewSets under api/ with real-time asynchronous task progress piped through Channels WebSocket ws/status/.", c.status = "VERIFIED", c.confidence = 1.00, c.evidence_type = "", c.source = "src/paperless/urls.py", c.verified = true, c.verified_by = "";
MERGE (c:IsnadClaim {id: "claim_001"}) ON CREATE SET c.assertion = "Multi-provider function comparison must force dimension status to 'unknown' with null counts when either side declares a required facet unavailable or when an empty facet lacks an explicit coverage declaration.", c.status = "VERIFIED", c.confidence = 1.00, c.evidence_type = "", c.source = "src/domain/functionComparisonDimensions.ts", c.verified = true, c.verified_by = "";
MERGE (c:IsnadClaim {id: "claim_002"}) ON CREATE SET c.assertion = "Absence of an artifact, entry, or property can only be formally claimed when the provider's inventory declares complete coverage, is not truncated, and omits zero entries; any other coverage state must yield 'unknown' rather than absence.", c.status = "VERIFIED", c.confidence = 1.00, c.evidence_type = "", c.source = "src/domain/comparisonSemantics.ts", c.verified = true, c.verified_by = "";
MERGE (c:IsnadClaim {id: "claim_003"}) ON CREATE SET c.assertion = "Comparing evidence produced by providers with differing representation formats (e.g. Ghidra vs Hopper assembly syntax) must record a 'providersDiffer' limitation and equate only structurally normalized projections, not raw provider text.", c.status = "VERIFIED", c.confidence = 1.00, c.evidence_type = "", c.source = "src/domain/functionComparison.ts", c.verified = true, c.verified_by = "";
MERGE (c:IsnadClaim {id: "claim_001"}) ON CREATE SET c.assertion = "Evidence-producing tools must return canonical Evidence records keyed by deterministic SHA-256 digests containing both normalized results and provider raw output.", c.status = "VERIFIED", c.confidence = 1.00, c.evidence_type = "", c.source = "src/domain/evidence.ts", c.verified = true, c.verified_by = "";
MERGE (c:IsnadClaim {id: "claim_002"}) ON CREATE SET c.assertion = "Comparing reverse-engineered artifacts requires explicit facet availability declarations; unobserved facets must not be treated as empty collections.", c.status = "VERIFIED", c.confidence = 1.00, c.evidence_type = "", c.source = "docs/mcp-contracts.md", c.verified = true, c.verified_by = "";
MERGE (c:IsnadClaim {id: "claim_003"}) ON CREATE SET c.assertion = "Reconstruction completeness requires a verified obligation closure digest proving zero unowned or contradicted behavioral surfaces across all 10 architecture layers.", c.status = "VERIFIED", c.confidence = 1.00, c.evidence_type = "", c.source = "src/domain/reconstructionObligationLedgerSchemas.ts", c.verified = true, c.verified_by = "";
MERGE (c:IsnadClaim {id: "ki_20260823_01-c1"}) ON CREATE SET c.assertion = "Untrusted or externally ingested plugins must execute in isolated subprocess sandboxes via JSON-RPC over stdin/stdout, reserving in-process execution strictly for trusted core plugins", c.status = "VERIFIED", c.confidence = 1.00, c.evidence_type = "", c.source = "", c.verified = true, c.verified_by = "";
MERGE (c:IsnadClaim {id: "ki_20260823_02-c1"}) ON CREATE SET c.assertion = "Overlapping window chunking (30-line chunks with step size of 25) combined with TF-IDF subword tokenization enables sub-second lexical and semantic search across massive (>80,000) conversational transcript steps", c.status = "VERIFIED", c.confidence = 1.00, c.evidence_type = "", c.source = "", c.verified = true, c.verified_by = "";
MERGE (c:IsnadClaim {id: "ki_20260823_03-c1"}) ON CREATE SET c.assertion = "Command chaining using POSIX '&&' fails unconditionally in Windows PowerShell environments with ParserError; automated CLI runners and scripts must normalize command chains to semicolons ';' or isolated subprocess arrays", c.status = "VERIFIED", c.confidence = 1.00, c.evidence_type = "", c.source = "", c.verified = true, c.verified_by = "";
MERGE (c:IsnadClaim {id: "ki_20260823_repo_01-c1"}) ON CREATE SET c.assertion = "Agent execution engines require platform-native sandboxing abstractions to enforce filesystem and network restrictions across Linux, macOS, and Windows", c.status = "VERIFIED", c.confidence = 1.00, c.evidence_type = "", c.source = "", c.verified = true, c.verified_by = "";
MERGE (c:IsnadClaim {id: "ki_20260823_repo_02-c1"}) ON CREATE SET c.assertion = "Command approval safety engines must tokenize shell syntax into AST prefix rules rather than relying on string matching or regexes", c.status = "VERIFIED", c.confidence = 1.00, c.evidence_type = "", c.source = "", c.verified = true, c.verified_by = "";
MERGE (c:IsnadClaim {id: "ki_20260823_repo_03-c1"}) ON CREATE SET c.assertion = "Complex safety verification, prompt injection screening, and risk scoring should run in forked subagent threads to avoid polluting parent conversational state", c.status = "VERIFIED", c.confidence = 1.00, c.evidence_type = "", c.source = "", c.verified = true, c.verified_by = "";
MERGE (c:IsnadClaim {id: "ki_20260823_repo_04-c1"}) ON CREATE SET c.assertion = "Hierarchical multi-agent topologies must be modeled with storage-neutral graph traits to cleanly support both ephemeral in-memory and persistent cloud backends", c.status = "VERIFIED", c.confidence = 1.00, c.evidence_type = "", c.source = "", c.verified = true, c.verified_by = "";
MERGE (c:IsnadClaim {id: "ki_20260823_repo_05-c1"}) ON CREATE SET c.assertion = "Agent daemons serving diverse clients (CLI, TUI, IDE) should enforce strict RPC wire protocols with automated cross-language type export to prevent wire drift", c.status = "VERIFIED", c.confidence = 1.00, c.evidence_type = "", c.source = "", c.verified = true, c.verified_by = "";
MERGE (c:IsnadClaim {id: "ki_20260824_repo_01-c1"}) ON CREATE SET c.assertion = "Facts in dynamic knowledge graphs must be modeled with bi-temporal valid_at and invalid_at timestamps to support non-destructive updates and historical state reconstruction", c.status = "VERIFIED", c.confidence = 1.00, c.evidence_type = "", c.source = "", c.verified = true, c.verified_by = "";
