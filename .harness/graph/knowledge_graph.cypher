MERGE (c:IsnadClaim {id: "ki_deepselect_adaptive_scan-c1"}) ON CREATE SET c.assertion = "DeepSelect decouples TopK compaction complexity from vocabulary length N by processing contiguous blocks B in uniform random permutation order, maintaining a monotonic non-decreasing threshold T initialized to -inf. Expected elements processed by in-loop Radix compactions is bounded by E[W] <= (1 + k/B2) * (k + B + B2) * H_m = O(k log(N/k)) when B, B2 = Theta(k).", c.status = "VERIFIED", c.confidence = 1.00, c.evidence_type = "", c.source = "", c.verified = true, c.verified_by = "";
MERGE (c:IsnadClaim {id: "ki_deepselect_bitmask_filtering-c1"}) ON CREATE SET c.assertion = "Traditional filtering requires two scans: one to count qualifying elements for shared memory slot allocation and a second to write them. DeepSelect eliminates the second scan by generating a 32-bit bitmask during the count phase using PTX instructions (set.s32.bf16x2, prmt.b32, dp4a.s32.s32), and subsequent placement traverses candidate indices via hardware __ffs(mask) and bit clearing mask &= mask - 1u.", c.status = "VERIFIED", c.confidence = 1.00, c.evidence_type = "", c.source = "", c.verified = true, c.verified_by = "";
MERGE (c:IsnadClaim {id: "ki_deepselect_cluster_partitioning-c1"}) ON CREATE SET c.assertion = "For workloads with small batch sizes or where total CTAs do not evenly divide the number of active SMs on high-end GPUs, wave quantization leads to severe tail SM idle cycles. DeepSelect groups CTAs into Threadblock Clusters (cluster_size up to 16), divides each sequence into segments across cluster CTAs, and streams local top-k candidates directly into CTA0 in shared cluster memory for final reduction.", c.status = "VERIFIED", c.confidence = 1.00, c.evidence_type = "", c.source = "", c.verified = true, c.verified_by = "";
MERGE (c:IsnadClaim {id: "ki_deepselect_denormal_fp32-c1"}) ON CREATE SET c.assertion = "For non-negative integers x, y <= 2^22, the bitwise integer addition result x + y is identical to treating their 32-bit patterns as IEEE-754 denormal floats and executing a floating-point addition: __float_as_uint(__uint_as_float(x) + __uint_as_float(y)). DeepSelect uses this to replace integer additions, bypassing ALU resource contention with bitwise/comparison instructions and achieving 2x throughput over integer multiply-add.", c.status = "VERIFIED", c.confidence = 1.00, c.evidence_type = "", c.source = "", c.verified = true, c.verified_by = "";
MERGE (c:IsnadClaim {id: "ki_egm_antagonistic_review_pipeline-c1"}) ON CREATE SET c.assertion = "A robust spec review requires a staged multi-phase pipeline where each phase applies a specialized rubric: Initial Zoom Out (simplicity), Naive Comprehension (self-containment), Critic (scale/failure modes), Intermediate Zoom Out (scope creep guard), and Implementation Readiness (concreteness).", c.status = "VERIFIED", c.confidence = 1.00, c.evidence_type = "review_protocol", c.source = "skills/egm-review/SKILL.md#L45-L160 & docs/designs/architecture.md#L75-L110", c.verified = true, c.verified_by = "";
MERGE (c:IsnadClaim {id: "ki_egm_antagonistic_review_pipeline-c2"}) ON CREATE SET c.assertion = "Subagent fan-out/fan-in coordination must be governed by an intermediate synthesizer persona that spawns concurrent reviewers, normalizes disparate natural language findings, deduplicates overlapping issues, and ranks by severity (Blocker, Major, Nit).", c.status = "VERIFIED", c.confidence = 1.00, c.evidence_type = "orchestration_pattern", c.source = "agents/synthesizer.md#L10-L75", c.verified = true, c.verified_by = "";
MERGE (c:IsnadClaim {id: "ki_egm_antagonistic_review_pipeline-c3"}) ON CREATE SET c.assertion = "After each review phase, human-in-the-loop tri-state checkpoint gates allow immediate in-thread remediation (via egm-resolve) to patch the spec in the Elephant context before advancing to subsequent stages.", c.status = "VERIFIED", c.confidence = 1.00, c.evidence_type = "human_in_the_loop_gate", c.source = "skills/egm-review/SKILL.md#L80-L150 & skills/egm-resolve/SKILL.md#L1-L60", c.verified = true, c.verified_by = "";
MERGE (c:IsnadClaim {id: "ki_egm_artifact_first_sdd_protocol-c1"}) ON CREATE SET c.assertion = "Dumping multi-page proposals, specs, or review findings directly into chat panes degrades LLM token context, causes conversational fatigue, and breaks reproducibility; all long-form assets must be emitted to dedicated workspace artifacts or files.", c.status = "VERIFIED", c.confidence = 1.00, c.evidence_type = "ux_architecture_rule", c.source = "docs/designs/architecture.md#L115-L130 & skills/egm-review/SKILL.md#L20-L30", c.verified = true, c.verified_by = "";
