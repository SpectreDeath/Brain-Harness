MERGE (c:IsnadClaim {id: "ki_icm_workspace_builder_metapipeline-c2"}) ON CREATE SET c.assertion = "A synthesized workspace passes validation only if it satisfies the Cold Walk Test: an agent or human unfamiliar with the domain can navigate the folder structure starting at CLAUDE.md following only relative links without guessing or encountering dead ends.", c.status = "VERIFIED", c.confidence = 1.00, c.evidence_type = "validation_invariant", c.source = "workspaces/workspace-builder/stages/05-validation/CONTEXT.md#L15-L40", c.verified = true, c.verified_by = "";
MERGE (c:IsnadClaim {id: "ki_icm_workspace_builder_metapipeline-c3"}) ON CREATE SET c.assertion = "Synthesized workspaces must enforce strict line limits: CONTEXT.md files must be <= 80 lines and reference files must be <= 200 lines to prevent token dilution and context degradation.", c.status = "VERIFIED", c.confidence = 1.00, c.evidence_type = "token_bound_rule", c.source = "README.md#L180-L195 & _core/CONVENTIONS.md#L270-L280", c.verified = true, c.verified_by = "";
MERGE (c:IsnadClaim {id: "ki_koos_typescript_harness_from_scratch-c1"}) ON CREATE SET c.assertion = "A production-grade AI agent harness can be constructed with zero framework dependencies in TypeScript using a provider-agnostic Model interface, structured run outcomes, and strict ReAct loop boundaries.", c.status = "VERIFIED", c.confidence = 1.00, c.evidence_type = "architectural_seam", c.source = "Gabor Koos: 'How to Build an AI Agent Harness from Scratch in TypeScript' (freeCodeCamp, 2026)", c.verified = true, c.verified_by = "";
MERGE (c:IsnadClaim {id: "ki_koos_typescript_harness_from_scratch-c2"}) ON CREATE SET c.assertion = "Passing unvalidated LLM-generated arguments directly to tools is a severe vulnerability; tool arguments must undergo pre-dispatch schema validation, and tool runtime errors must be strictly bifurcated from terminal model provider failures.", c.status = "VERIFIED", c.confidence = 1.00, c.evidence_type = "security_standard", c.source = "Gabor Koos: Tool Registry & Validation (2026)", c.verified = true, c.verified_by = "";
MERGE (c:IsnadClaim {id: "ki_koos_typescript_harness_from_scratch-c3"}) ON CREATE SET c.assertion = "Filesystem sandboxing cannot rely solely on the final target path; robust path confinement requires canonical realpath resolution, lexical boundary checking, component-by-component ancestor lstat walking to reject intermediate symlinks, and O_NOFOLLOW file open flags.", c.status = "VERIFIED", c.confidence = 1.00, c.evidence_type = "security_standard", c.source = "Gabor Koos: Workspace Isolation (2026)", c.verified = true, c.verified_by = "";
MERGE (c:IsnadClaim {id: "ki_koos_typescript_harness_from_scratch-c4"}) ON CREATE SET c.assertion = "Allowing models to formulate raw shell command strings or select arbitrary executables permits command injection; agent command execution must be locked to developer-defined presets with shell: false and bounded output buffers.", c.status = "VERIFIED", c.confidence = 1.00, c.evidence_type = "security_standard", c.source = "Gabor Koos: Hardened Command Execution (2026)", c.verified = true, c.verified_by = "";
MERGE (c:IsnadClaim {id: "ki_koos_typescript_harness_from_scratch-c5"}) ON CREATE SET c.assertion = "Tool invocation budget enforcement must occur atomically before conversation transcript mutation; admitting partial tool batches or appending assistant calls before budget verification creates orphaned, unfulfilled tool calls.", c.status = "VERIFIED", c.confidence = 1.00, c.evidence_type = "architectural_seam", c.source = "Gabor Koos: Batch Budgeting Section (2026)", c.verified = true, c.verified_by = "";
MERGE (c:IsnadClaim {id: "ki_koos_typescript_harness_from_scratch-c6"}) ON CREATE SET c.assertion = "Sliding context windowing must treat each assistant turn and all its corresponding tool result messages as an indivisible atomic unit, preventing conversational incoherence from orphaned results or broken tool-call links.", c.status = "VERIFIED", c.confidence = 1.00, c.evidence_type = "architectural_seam", c.source = "Gabor Koos: Context Window Management (2026)", c.verified = true, c.verified_by = "";
MERGE (c:IsnadClaim {id: "ki_koos_typescript_harness_from_scratch-c7"}) ON CREATE SET c.assertion = "Telemetry and observer listeners must be wrapped in isolated try-catch boundaries so that non-essential reporting errors never fail or alter the outcome of an otherwise successful agent execution.", c.status = "VERIFIED", c.confidence = 1.00, c.evidence_type = "reliability_pattern", c.source = "Gabor Koos: Telemetry and Observability (2026)", c.verified = true, c.verified_by = "";
